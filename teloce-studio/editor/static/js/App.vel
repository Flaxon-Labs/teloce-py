<template>
  <main class="studio-shell">
    <header class="studio-topbar"><a class="brand" href="/"><span class="brand-mark">T</span><span>Teloce Studio</span></a><div class="top-actions"><span class="save-status">{{ status }}</span><button @click="undo" :disabled="!past.length">Undo</button><button @click="redo" :disabled="!future.length">Redo</button><button @click="createProject">New project</button><button class="primary" @click="generate">Generate app</button></div></header>
    <section class="studio-body">
      <aside class="left-panel"><div class="panel-title"><span>Project</span><button @click="createProject">＋</button></div><input class="project-name" v-model="project.name" @change="save" aria-label="Project name" /><div class="tree-label">INSERT</div><button class="palette-item" @click="addElement('heading')">T Heading</button><button class="palette-item" @click="addElement('text')">¶ Text</button><button class="palette-item" @click="addElement('button')">▣ Button</button><button class="palette-item" @click="addElement('card')">□ Card</button><div class="tree-label">PAGE ELEMENTS</div><button v-for="element in project.elements" :key="element.id" :class="['tree-item', selectedId === element.id ? 'active' : '']" @click="selectElement(element.id)">▣ {{ element.label }} <small>{{ element.type }}</small></button><div class="left-bottom"><button class="tree-item" @click="showDiagnostics">◇ Diagnostics</button><button class="tree-item" @click="exportProject">⇩ Export project</button></div></aside>
      <section class="workspace"><div class="workspace-toolbar"><div><strong>{{ project.name }}</strong><span class="crumb"> / Home</span></div><div class="device-actions"><button :class="{selected: device === 'desktop'}" @click="device='desktop'">Desktop</button><button :class="{selected: device === 'mobile'}" @click="device='mobile'">Mobile</button><button @click="preview">▶ Validate preview</button></div></div><div class="canvas-wrap"><div :class="['canvas', device === 'mobile' ? 'mobile-canvas' : '']"><div class="canvas-page"><div class="canvas-toolbar">Home page <span>⋮</span></div><div v-for="element in project.elements" :key="element.id" :class="['canvas-element', 'studio-'+element.type, selectedId === element.id ? 'selected-element' : '']" @click="selectElement(element.id)"><span class="selection-tag">{{ element.label }}</span><strong>{{ element.text }}</strong><small>{{ element.type }} component</small></div><div v-if="!project.elements.length" class="canvas-block"><strong>Start building your page</strong><span>Choose a component from the Insert panel.</span></div></div></div></div></section>
      <aside class="right-panel"><div class="tabs"><button :class="{active: inspector === 'design'}" @click="inspector='design'">Design</button><button :class="{active: inspector === 'code'}" @click="inspector='code'">Code</button><button :class="{active: inspector === 'data'}" @click="inspector='data'">Data</button></div><div v-if="inspector === 'design'" class="inspector"><div class="inspector-heading">Selected element <span>{{ selectedId || 'None' }}</span></div><label>Text<input v-model="selectedText" @change="updateSelectedText" /></label><label>Primary color<input type="color" v-model="project.theme.primary" @change="save" /></label><button class="danger-button" @click="removeElement">Delete selected element</button><div class="inspector-heading">Responsive</div><div class="breakpoints"><button @click="device='desktop'">Desktop</button><button @click="device='mobile'">Mobile</button></div><div class="inspector-heading">Events</div><button class="event-row" @click="inspector='data'">＋ Add click action</button></div><div v-if="inspector === 'code'" class="inspector"><div class="code-heading">Generated .vel</div><pre>&lt;template&gt; &lt;main class=&quot;page-shell&quot;&gt; &lt;h1&gt;{{ project.name }}&lt;/h1&gt; &lt;/main&gt; &lt;/template&gt;</pre><button class="wide-button" @click="generate">Regenerate files</button></div><div v-if="inspector === 'data'" class="inspector"><div class="inspector-heading">Flaxon backend</div><p class="muted">Connect this page to a generated API route, service, or database model.</p><button class="event-row">＋ Add API binding</button><button class="event-row">＋ Add form action</button><div class="inspector-heading">Project files</div><p class="file-chip">app.py</p><p class="file-chip">static/js/pages/Home.vel</p><p class="file-chip">teloce-studio.json</p></div></aside>
    </section><footer class="studio-footer"><span>Local-first workspace · Generated code stays yours</span><span>Flaxon backend · Teloce .vel frontend · PWA ready</span></footer><div v-if="diagnostics" class="diagnostics"><div class="diagnostics-head"><strong>Diagnostics</strong><button @click="diagnostics=false">×</button></div><p>{{ diagnosticMessage }}</p></div>
  </main>
</template>
<script>
export default { data() { return { project: { id: '', name: 'My Flaxon App', pages: [{ id: 'home', name: 'Home', path: '/' }], elements: [], theme: { primary: '#6c63ff' } }, status: 'Loading workspace…', device: 'desktop', inspector: 'design', selectedId: '', selectedText: '', past: [], future: [], diagnostics: false, diagnosticMessage: 'No diagnostics yet.' } }, mounted() { this.load() }, methods: { snapshot() { return JSON.parse(JSON.stringify(this.project)) }, remember() { this.past = this.past.concat([this.snapshot()]).slice(-30); this.future = [] }, async load() { try { const response = await fetch('/api/projects'); const data = await response.json(); if (data.projects && data.projects.length) { const loaded = await fetch('/api/projects/' + data.projects[0].id); this.project = (await loaded.json()).project } else { await this.save() }; this.project.elements = this.project.elements || []; this.project.theme = this.project.theme || { primary: '#6c63ff' }; if (!this.selectedId && this.project.elements.length) this.selectElement(this.project.elements[0].id); this.status = 'Saved locally' } catch (_) { this.status = 'Offline workspace' } }, async save() { try { const method = this.project.id ? 'PUT' : 'POST'; const url = this.project.id ? '/api/projects/' + this.project.id : '/api/projects'; const response = await fetch(url, { method, headers: { 'content-type': 'application/json' }, body: JSON.stringify(this.project) }); const data = await response.json(); if (data.project) this.project = data.project; this.status = 'Saved just now' } catch (_) { this.status = 'Saved in editor state' } }, async createProject() { this.remember(); this.project = { id: '', name: 'New Flaxon App', pages: [{ id: 'home', name: 'Home', path: '/' }], elements: [], theme: { primary: '#6c63ff' } }; this.selectedId = ''; await this.save() }, addElement(type) { this.remember(); const id = type + '-' + Date.now(); const labels = { heading: 'Heading', text: 'Text block', button: 'Button', card: 'Card' }; this.project.elements = this.project.elements.concat([{ id, type, label: labels[type] || 'Element', text: labels[type] || 'Element' }]); this.selectElement(id); this.save() }, selectElement(id) { this.selectedId = id; const selected = this.project.elements.find(item => item.id === id); this.selectedText = selected?.text || '' }, updateSelectedText() { this.remember(); const selected = this.project.elements.find(item => item.id === this.selectedId); if (selected) selected.text = this.selectedText; this.save() }, removeElement() { if (!this.selectedId) return; this.remember(); this.project.elements = this.project.elements.filter(item => item.id !== this.selectedId && item.parentId !== this.selectedId); this.selectedId = ''; this.selectedText = ''; this.save() }, undo() { if (!this.past.length) return; this.future = [this.snapshot()].concat(this.future); this.project = this.past[this.past.length - 1]; this.past = this.past.slice(0, -1) }, redo() { if (!this.future.length) return; this.past = this.past.concat([this.snapshot()]); this.project = this.future[0]; this.future = this.future.slice(1) }, async generate() { this.status = 'Generating…'; await this.save(); const response = await fetch('/api/projects/' + this.project.id + '/generate', { method: 'POST' }); const data = await response.json(); this.status = data.ok ? 'Generated successfully' : 'Generation failed'; this.diagnosticMessage = data.ok ? data.files.join(', ') : data.error }, async preview() { if (!this.project.id) await this.save(); const response = await fetch('/api/projects/' + this.project.id + '/preview'); const data = await response.json(); this.diagnostics = true; this.diagnosticMessage = data.ok ? 'Preview build passed.' : JSON.stringify(data.issues || data.diagnostics || data.error) }, showDiagnostics() { this.diagnostics = true }, exportProject() { window.location.href = '/api/projects/' + this.project.id + '/export' } } }
</script>
