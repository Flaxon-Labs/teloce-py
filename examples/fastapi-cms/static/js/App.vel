<template>
  <main class="cms"><p class="eyebrow">FastAPI + Teloce</p><h1>Content studio</h1><p class="subhead">Edit pages through a typed Python API.</p><p v-if="error" class="error">{{ error }}</p>
    <div class="workspace"><aside><p class="label">Pages</p><button v-for="page in pages" :key="page.slug" @click="select(page)">{{ page.title }}</button></aside>
    <section v-if="selected" class="editor"><label>Page title<input v-model="selected.title" /></label><label>Body<textarea v-model="selected.body"></textarea></label><div class="actions"><button @click="save">Save page</button><span v-if="saved" class="saved">Saved</span></div></section></div>
  </main>
</template>
<script>
export default { data() { return { pages: [], selected: null, saved: false, error: "" }; }, mounted() { this.load(); }, methods: {
  async load() { try { this.pages = await fetch("/api/pages").then((r) => r.json()); this.selected = this.pages[0]; } catch (e) { this.error = "CMS API unavailable"; } },
  select(page) { this.selected = page; this.saved = false; },
  async save() { const response = await fetch(`/api/pages/${this.selected.slug}`, { method: "PUT", headers: { "Content-Type": "application/json" }, body: JSON.stringify(this.selected) }); this.selected = await response.json(); this.saved = true; }
} };
</script>
<style scoped>
* { box-sizing: border-box; } .cms { min-height: 100vh; padding: clamp(2rem, 7vw, 5rem) max(1.25rem, calc((100% - 62rem) / 2)); background: #f5f7fb; color: #192235; font: 1rem system-ui, sans-serif; } .eyebrow { margin: 0; color: #0d8a76; font-size: .75rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; } h1 { margin: .5rem 0 .25rem; font-size: clamp(2.3rem, 7vw, 4rem); letter-spacing: -.06em; } .subhead { color: #6b7890; } .workspace { display: grid; grid-template-columns: 14rem 1fr; gap: 1rem; margin-top: 2rem; } aside, .editor { border: 1px solid #dbe3ef; border-radius: 1rem; background: #fff; padding: 1rem; box-shadow: 0 1rem 3rem #2a477a0d; } .label { margin: 0 0 .7rem; color: #7a879d; font-size: .75rem; font-weight: 800; text-transform: uppercase; } aside button { display: block; width: 100%; margin: .4rem 0; border: 0; border-radius: .6rem; padding: .7rem; background: #edf2f8; color: #27344b; text-align: left; cursor: pointer; } aside button:hover { background: #dceeea; } .editor { display: grid; gap: 1rem; } label { display: grid; gap: .4rem; color: #53627b; font-weight: 700; } input, textarea { width: 100%; border: 1px solid #cbd6e5; border-radius: .6rem; padding: .75rem; color: inherit; font: inherit; } textarea { min-height: 12rem; resize: vertical; } .actions { display: flex; align-items: center; gap: 1rem; } .actions button { border: 0; border-radius: .7rem; padding: .75rem 1rem; background: #0d8a76; color: #fff; font-weight: 700; cursor: pointer; } .saved { color: #0d8a76; font-weight: 700; } .error { color: #b42318; } @media (max-width: 42rem) { .workspace { grid-template-columns: 1fr; } aside { display: grid; grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr)); gap: .5rem; } .label { grid-column: 1 / -1; } }
</style>
