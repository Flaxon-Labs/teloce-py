<template><main class="scanner"><p class="eyebrow">Django + Teloce</p><h1>Public header scanner</h1><p class="subhead">Check security headers on a public URL you are authorized to test.</p><form @submit.prevent="scan"><label for="target">Website URL</label><div class="form-row"><input id="target" v-model="url" type="url" placeholder="https://example.com" /><button :disabled="loading">{{ loading ? "Checking..." : "Scan" }}</button></div></form><p v-if="error" class="error">{{ error }}</p><section v-if="result" class="result"><h2>{{ result.status }} · {{ result.url }}</h2><ul><li v-for="finding in result.findings" :key="finding.header"><span :class="finding.present ? 'present' : 'missing'">{{ finding.present ? "✓" : "!" }}</span>{{ finding.header }}<strong>{{ finding.present ? "Present" : "Missing" }}</strong></li></ul></section></main></template>
<script>
export default { data() { return { url: "https://example.com", loading: false, result: null, error: "" }; }, methods: { async scan() { this.loading = true; this.error = ""; try { const response = await fetch("/api/scan", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ url: this.url }) }); const data = await response.json(); if (!response.ok) throw new Error(data.error); this.result = data; } catch (error) { this.error = error.message; } finally { this.loading = false; } } } };
</script>
<style scoped>
* { box-sizing: border-box; } .scanner { min-height: 100vh; padding: clamp(2rem, 8vw, 6rem) max(1.25rem, calc((100% - 54rem) / 2)); background: #101827; color: #edf3ff; font: 1rem system-ui, sans-serif; } .eyebrow { color: #53d6be; font-size: .75rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; } h1 { margin: .5rem 0 .25rem; font-size: clamp(2.2rem, 7vw, 4rem); letter-spacing: -.06em; } .subhead { color: #a8b5ca; } label { display: block; margin-top: 2rem; margin-bottom: .45rem; color: #b8c5db; font-weight: 700; } .form-row { display: flex; gap: .6rem; } input { min-width: 0; flex: 1; border: 1px solid #34445f; border-radius: .7rem; padding: .85rem 1rem; background: #18243a; color: #fff; font: inherit; } button { border: 0; border-radius: .7rem; padding: .85rem 1.1rem; background: #2bb69c; color: #071b1a; font-weight: 800; cursor: pointer; } button:disabled { opacity: .55; cursor: wait; } .error { margin-top: 1rem; color: #ff9fae; } .result { margin-top: 2rem; padding: 1.2rem; border: 1px solid #34445f; border-radius: 1rem; background: #18243a; } .result h2 { overflow-wrap: anywhere; font-size: 1rem; } .result ul { padding: 0; list-style: none; } .result li { display: grid; grid-template-columns: 1.5rem 1fr auto; gap: .6rem; align-items: center; padding: .7rem 0; border-bottom: 1px solid #2b3953; } .result li:last-child { border-bottom: 0; } .present { color: #53d6be; } .missing { color: #ff9fae; } .result strong { color: #a8b5ca; font-size: .85rem; } @media (max-width: 30rem) { .form-row { flex-direction: column; } button { width: 100%; } .result li { grid-template-columns: 1.5rem 1fr; } .result strong { grid-column: 2; } }
</style>
