<template><main class="scanner"><h1>Django web scanner</h1><p>Checks public response headers only.</p><form @submit.prevent="scan"><input v-model="url" type="url" placeholder="https://example.com" /><button :disabled="loading">{{ loading ? "Checking..." : "Scan" }}</button></form><p v-if="error" class="error">{{ error }}</p><section v-if="result"><h2>{{ result.url }} ({{ result.status }})</h2><ul><li v-for="finding in result.findings" :key="finding.header">{{ finding.header }}: {{ finding.present ? "present" : "missing" }}</li></ul></section></main></template>
<script>
export default { data() { return { url: "https://example.com", loading: false, result: null, error: "" }; }, methods: { async scan() { this.loading = true; this.error = ""; try { const response = await fetch("/api/scan", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ url: this.url }) }); const data = await response.json(); if (!response.ok) throw new Error(data.error); this.result = data; } catch (error) { this.error = error.message; } finally { this.loading = false; } } } };
</script>
<style scoped>.scanner { max-width: 50rem; margin: 3rem auto; font: 1rem system-ui; } form { display: flex; gap: .5rem; } input { flex: 1; padding: .7rem; } .error { color: #b42318; }</style>
