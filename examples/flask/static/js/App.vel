.dashboard { min-height: 100vh; padding: clamp(2rem, 9vw, 7rem) max(1.25rem, calc((100% - 44rem) / 2)); background: #101827; color: #edf3ff; font: 16px/1.5 system-ui, sans-serif; } .eyebrow { color: #8ea8ff; font-size: .75rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; } h1 { margin: .5rem 0 2rem; font-size: clamp(2.4rem, 8vw, 4.5rem); letter-spacing: -.06em; }
.profile { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem; padding: 1rem; border: 1px solid #2b3953; border-radius: 1rem; background: #18243a; } .profile p { margin: .15rem 0 0; color: #9eabc1; } .avatar { display: grid; width: 3rem; height: 3rem; place-items: center; border-radius: 50%; background: #6e7dff; font-weight: 800; } .dot { width: .65rem; height: .65rem; margin-left: auto; border-radius: 50%; background: #3dd598; box-shadow: 0 0 0 .25rem #3dd59822; }
