<template>
  <main class="app">
    <p class="eyebrow">Teloce starter</p>
    <h1>{{ title }}</h1>
    <p class="lede">A small reactive task board compiled from a single <code>.vel</code>&nbsp;file.</p>
    <div class="summary"><span>{{ tasks.length }}&nbsp;tasks</span><button @click="addTask">Add task</button></div>
    <if condition="tasks.length > 0">
      <ul class="tasks"><for item in tasks><li><span class="check">✓</span>{{ item }}</li></for></ul>
    </if>
  </main>
</template>
<script>
export default {
  data() { return { title: "Task board", tasks: ["Plan release", "Run tests"] }; },
  methods: { addTask() { this.tasks.push("Review pull request"); } }
}
</script>
<style scoped>
