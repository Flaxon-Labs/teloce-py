<template>
  <main class="dashboard">
    <p class="eyebrow">Flask + Teloce</p><h1>{{ heading }}</h1>
    <div class="profile"><div class="avatar">{{ user.name.slice(0, 1) }}</div><div><strong>{{ user.name }}</strong><p>{{ user.active ? "Active workspace" : "Signed out" }}</p></div><span class="dot"></span></div>
    <button @click="toggle">{{ user.active ? "Sign out" : "Sign in" }}</button>
    <if condition="user.active"><p class="status">✓ Your workspace is ready.</p></if>
  </main>
</template>
<script>
export default {
  data() { return { heading: "Flask dashboard", user: { name: "Developer", active: true } }; },
  methods: { toggle() { this.user.active = !this.user.active; } }
}
</script>
<style scoped>
