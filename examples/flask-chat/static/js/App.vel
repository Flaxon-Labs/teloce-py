<template>
  <main class="chat">
    <p class="eyebrow">Flask API demo</p><h1>{{ title }}</h1><p class="subhead">A small chat interface backed by JSON routes.</p>
    <p v-if="error" class="error">{{ error }}</p>
    <ol class="messages">
      <li v-for="message in messages" :key="message.id"><strong>{{ message.author }}</strong><span>{{ message.body }}</span></li>
    </ol>
    <form @submit.prevent="send">
      <input v-model="draft" aria-label="Message" placeholder="Write a message" />
      <button :disabled="sending || !draft.trim()">{{ sending ? "Sending..." : "Send" }}</button>
    </form>
  </main>
</template>
<script>
export default {
  data() { return { title: "Flask chat", messages: [], draft: "", sending: false, error: "" }; },
  mounted() { this.load(); },
  methods: {
    async load() {
      try { this.messages = await fetch("/api/messages").then((response) => response.json()); }
      catch (error) { this.error = "Could not load messages."; }
    },
    async send() {
      if (!this.draft.trim()) return;
      this.sending = true;
      try {
        const message = await fetch("/api/messages", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ body: this.draft }) }).then((response) => response.json());
        if (message.error) throw new Error(message.error);
        this.messages.push(message); this.draft = "";
      } catch (error) { this.error = error.message; }
      finally { this.sending = false; }
    }
  }
};
</script>
<style scoped>
* { box-sizing: border-box; } .chat { min-height: 100vh; padding: clamp(2rem, 8vw, 6rem) max(1.25rem, calc((100% - 44rem) / 2)); background: #f3f6fb; color: #172033; font: 1rem system-ui, sans-serif; } .eyebrow { margin: 0; color: #2878d7; font-size: .75rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; } h1 { margin: .5rem 0 .25rem; font-size: clamp(2.2rem, 8vw, 4rem); letter-spacing: -.06em; } .subhead { color: #6b7890; } .messages { display: flex; min-height: 14rem; flex-direction: column; gap: .65rem; margin: 2rem 0 1rem; padding: 1rem; border: 1px solid #dbe3f0; border-radius: 1rem; background: #fff; list-style: none; box-shadow: 0 1rem 3rem #2a477a12; } .messages li { display: flex; flex-direction: column; gap: .15rem; width: fit-content; max-width: 85%; padding: .75rem 1rem; border-radius: .85rem; background: #edf3ff; } .messages li:nth-child(even) { align-self: flex-end; background: #dceeff; } form { display: flex; gap: .6rem; } input { min-width: 0; flex: 1; border: 1px solid #cbd6e8; border-radius: .7rem; padding: .8rem 1rem; font: inherit; } button { border: 0; border-radius: .7rem; padding: .8rem 1.1rem; background: #2878d7; color: #fff; font-weight: 700; cursor: pointer; } button:disabled { cursor: not-allowed; opacity: .5; } .error { color: #b42318; } @media (max-width: 30rem) { form { flex-direction: column; } button { width: 100%; } }
</style>
