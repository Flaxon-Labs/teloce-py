<template>
  <main class="studio-shell"><header class="studio-topbar"><a class="brand" href="/"><span class="brand-mark">T</span><span>Teloce Studio</span></a><div class="top-actions"><span class="save-status">{{ status }}</span><button @click="createProject">New project</button><button class="primary" @click="generate">Generate app</button></div></header><section class="studio-body"><aside class="left-panel"><div class="panel-title"><span>Project</span><button @click="createProject">＋</button></div><input class="project-name" v-model="project.name" @change="save" aria-label="Project name" /><div class="tree-label">PAGES</div><button v-for="page in project.pages" :key="page.id" class="tree-item active">▣ {{ page.name }} <small>{{ page.path }}</small></button><div class="tree-label">COMPONENTS</div><button class="tree-item" @click="addComponent">＋ Add component</button><div class="left-bottom"><button class="tree-item" @click="showDiagnostics">◇ Diagnostics</button><button class="tree-item" @click="exportProject">⇩ Export project</button></div></aside><section class="workspace"><div class="workspace-toolbar"><div><strong>{{ project.name }}</strong><span class="crumb"> / Home</span></div><div class="device-actions"><button :class="{selected: device === 'desktop'}" @click="device='desktop'">Desktop</button><button :class="{selected: device === 'mobile'}" @click="device='mobile'">Mobile</button><button @click="preview">▶ Preview</button></div></div><div class="canvas-wrap"><div :class="['canvas', device === 'mobile' ? 'mobile-canvas' : '']"><div class="canvas-page"><div class="canvas-toolbar">Home page <span>⋮</span></div><div class="hero-block"><span class="selection-tag">Hero section</span><h1>{{ project.name }}</h1><p>Build a real Flaxon application with visual tools and editable .vel files.</p><button class="canvas-button" @click="selectElement('Button')">Get started</button></div><div class="canvas-block"><strong>Drag components here</strong><span>Choose an element from the insert panel to grow this page.</span></div></div></div></div></section><aside class="right-panel"><div class="tabs"><button :class="{active: inspector === 'design'}" @click="inspector='design'">Design</button><button :class="{active: inspector === 'code'}" @click="inspector='code'">Code</button><button :class="{active: inspector === 'data'}" @click="inspector='data'">Data</button></div><div v-if="inspector === 'design'" class="inspector"><div class="inspector-heading">Selected element <span>{{ selected }}</span></div><label>Text<input v-model="selected" /></label><label>Primary color<input type="color" v-model="project.theme.primary" @change="save" /></label><div class="inspector-heading">Responsive</div><div class="breakpoints"><button>Desktop</button><button>Tablet</button><button>Mobile</button></div><div class="inspector-heading">Events</div><button class="event-row" @click="inspector='data'">＋ Add click action</button></div><div v-if="inspector === 'code'" class="inspector"><div class="code-heading">Generated .vel</div><pre>&lt;template&gt; &lt;main class="page-shell"&gt; &lt;h1&gt;{{ project.name }}&lt;/h1&gt; &lt;/main&gt; &lt;/template&gt;</pre><button class="wide-button" @click="generate">Regenerate files</button></div><div v-if="inspector === 'data'" class="inspector"><div class="inspector-heading">Flaxon backend</div><p class="muted">Connect this page to a generated API route, service, or database model.</p><button class="event-row">＋ Add API binding</button><button class="event-row">＋ Add form action</button><div class="inspector-heading">Project files</div><p class="file-chip">app.py</p><p class="file-chip">static/js/pages/Home.vel</p><p class="file-chip">teloce-studio.json</p></div></aside></section><footer class="studio-footer"><span>Local-first workspace · Generated code stays yours</span><span>Flaxon backend · Teloce .vel frontend · PWA ready</span></footer><div v-if="diagnostics" class="diagnostics"><div class="diagnostics-head"><strong>Diagnostics</strong><button @click="diagnostics=false">×</button></div><p>{{ diagnosticMessage }}</p></div></main>
</template>
<script>
export default { data() { return { project: { id: '', name: 'My Flaxon App', pages: [{ id: 'home', name: 'Home', path: '/' }], theme: { primary: '#6c63ff' } }, status: 'Loading workspace…', device: 'desktop', inspector: 'design', selected: 'Hero section', diagnostics: false, diagnosticMessage: 'No diagnostics yet.' } }, mounted() { this.load() }, methods: { async load() { try { const response = await fetch('/api/projects'); const data = await response.json(); if (data.projects && data.projects.length) { const loaded = await fetch('/api/projects/' + data.projects[0].id); this.project = (await loaded.json()).project } else { await this.save() }; this.status = 'Saved locally' } catch (_) { this.status = 'Offline workspace' } }, async save() { try { const method = this.project.id ? 'PUT' : 'POST'; const url = this.project.id ? '/api/projects/' + this.project.id : '/api/projects'; const response = await fetch(url, { method, headers: { 'content-type': 'application/json' }, body: JSON.stringify(this.project) }); const data = await response.json(); if (data.project) this.project = data.project; this.status = 'Saved just now' } catch (_) { this.status = 'Saved in editor state' } }, async createProject() { this.project = { id: '', name: 'New Flaxon App', pages: [{ id: 'home', name: 'Home', path: '/' }], theme: { primary: '#6c63ff' } }; await this.save() }, async generate() { this.status = 'Generating…'; await this.save(); const response = await fetch('/api/projects/' + this.project.id + '/generate', { method: 'POST' }); const data = await response.json(); this.status = data.ok ? 'Generated successfully' : 'Generation failed'; this.diagnosticMessage = data.ok ? data.files.join(', ') : data.error }, addComponent() { this.selected = 'New component'; this.status = 'Component selected' }, selectElement(value) { this.selected = value; this.inspector = 'design' }, preview() { this.status = 'Preview uses generated files' }, showDiagnostics() { this.diagnostics = true }, exportProject() { this.diagnostics = true; this.diagnosticMessage = 'Project export is queued for the next implementation slice.' } } }
</script>
