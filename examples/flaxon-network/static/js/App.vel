<template><main class="network"><p class="eyebrow">Flaxon operations</p><h1>Network operations</h1><div class="toolbar"><p>Live device inventory</p><button @click="load">Refresh</button></div><p v-if="error" class="error">{{ error }}</p><ul><li v-for="device in devices" :key="device.name"><div><strong>{{ device.name }}</strong><span>{{ device.address }}</span></div><span class="status">{{ device.status }}</span><button @click="check(device)">Check</button></li></ul></main></template>
<script>
export default { data() { return { devices: [], error: "" }; }, mounted() { this.load(); }, methods: { async load() { try { this.devices = (await fetch("/api/devices").then((r) => r.json())).devices; } catch (error) { this.error = "Network API unavailable"; } }, async check(device) { const result = await fetch(`/api/devices/${device.name}/check`, { method: "POST" }).then((r) => r.json()); device.status = result.status; } } };
</script>
<style scoped>
* { box-sizing: border-box; } .network { min-height: 100vh; padding: clamp(2rem, 8vw, 6rem) max(1.25rem, calc((100% - 58rem) / 2)); background: #0f1724; color: #edf3ff; font: 1rem system-ui, sans-serif; } .eyebrow { color: #7ed8ff; font-size: .75rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; } h1 { margin: .5rem 0 1.5rem; font-size: clamp(2.3rem, 7vw, 4rem); letter-spacing: -.06em; } .toolbar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; color: #a8b5ca; } .toolbar p { margin: 0; } button { border: 0; border-radius: .6rem; padding: .65rem .9rem; background: #287fc2; color: #fff; font-weight: 700; cursor: pointer; } ul { margin: 0; padding: 0; list-style: none; } li { display: grid; grid-template-columns: 1fr auto auto; gap: 1rem; align-items: center; margin: .65rem 0; padding: 1rem; border: 1px solid #2c3d57; border-radius: .9rem; background: #18253a; } li div { display: grid; gap: .2rem; } li span { color: #92a4bd; font-size: .9rem; } .status { color: #63e0ad !important; } .error { color: #ff9fae; } @media (max-width: 36rem) { li { grid-template-columns: 1fr auto; } li button { grid-column: 2; grid-row: 1 / span 2; } .toolbar { align-items: flex-start; } }
</style>
