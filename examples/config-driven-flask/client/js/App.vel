<template>
  <main class="shell">
    <p class="eyebrow">teloce.config.json</p>
    <h1>{{ title }}</h1>
    <p>This page was compiled from a custom <code>client/</code> source tree.</p>
    <StatusCard label="Shared runtime" detail="One runtime file is imported by both components." />
    <button type="button" @click="toggle">{{ enabled ? "Configuration enabled" : "Enable configuration" }}</button>
  </main>
</template>

<script>
import StatusCard from "./components/StatusCard.vel";

export default {
  components: { StatusCard },
  data() { return { title: "Configured builds stay predictable", enabled: true }; },
  methods: { toggle() { this.enabled = !this.enabled; } },
};
</script>

