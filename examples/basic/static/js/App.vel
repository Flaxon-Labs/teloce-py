.app:before { content: ""; display: block; width: 3rem; height: .3rem; margin-bottom: 2rem; border-radius: 99px; background: #635bff; }
.eyebrow { margin: 0 0 .5rem; color: #635bff; font-size: .75rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
h1 { margin: 0; font-size: clamp(2.2rem, 7vw, 4rem); letter-spacing: -.05em; } .lede { color: #65708a; }
.summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 2rem; padding: 1rem; border: 1px solid #dce2f4; border-radius: 1rem; background: #fff; box-shadow: 0 1rem 3rem #25345b12; }
button { border: 0; border-radius: .7rem; padding: .7rem 1rem; background: #635bff; color: #fff; font-weight: 700; cursor: pointer; } button:hover { background: #4c45d8; } button:focus-visible { outline: 3px solid #a8b3ff; outline-offset: 2px; }
.tasks { margin: 1rem 0 0; padding: 0; list-style: none; } .tasks li { display: flex; gap: .8rem; align-items: center; margin: .65rem 0; padding: 1rem; border: 1px solid #dce2f4; border-radius: .8rem; background: #fff; } .check { color: #0f9f76; font-weight: 800; }
