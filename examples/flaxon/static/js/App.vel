<template>
  <main class="portal">
    <p class="eyebrow">Flaxon + Jinax</p><h1>{{ product }}</h1>
    <div class="plan"><span class="plan-icon">✦</span><div><strong>{{ plan === "professional" ? "Professional plan" : "Starter plan" }}</strong><p>{{ plan === "professional" ? "Everything is ready to ship." : "A simple starting point for your app." }}</p></div></div>
    <button @click="choose">{{ plan === "professional" ? "Plan selected" : "Choose professional" }}</button>
    <if condition="plan === 'professional'"><p class="success">✓ Thanks for upgrading.</p></if>
  </main>
</template>
<script>
export default {
  data() { return { product: "Flaxon Portal", plan: "starter" }; },
  methods: { choose() { this.plan = "professional"; } }
}
</script>
